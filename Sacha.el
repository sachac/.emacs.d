				(todo (org-get-todo-state))
				matcher)
		(catch 'found
			(dolist (target my-org-refile-tag-targets)
				(setq matcher (cdr (org-make-tags-matcher (car target))))
				(when (funcall matcher todo tags level)
					(throw 'found target))))))

