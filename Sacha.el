(defun my-lang-gptel-clarify (extra &optional context previous-feedback log-only)
  (interactive (list
                (read-string "Text: ")
                (if (region-active-p)
                    (concat " "
                            (buffer-substring-no-properties
                             (region-beginning)
                             (region-end)))
                  (substring-no-properties (sentence-at-point)))
                (when-let* ((errors
