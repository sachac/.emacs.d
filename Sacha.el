							                           (format "<table><tbody><tr><td style=\"padding: 12px 24px 12px 24px\"><h2>Other updates</h2>%s</td></tr></tbody></table>"
											                           (my-transform-html
												                          nil
												                          (car (assoc-default "Other updates" sections #'string=))))
						                           "")
					                           "</td></tr></tbody></table>")))
		(when (called-interactively-p 'any)
			(kill-new html))
