                    "")
								  (format "<span class=\"audio-time caption\" data-start=\"%f\" data-stop=\"%f\" >%s</span>"
												  (/ (elt cue 1) 1000.0)
												  (/ (elt cue 2) 1000.0)
												  (elt cue 3))))
