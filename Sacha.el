(defun my-french-lexique-complete-word ()
  (interactive)
  (let* ((selection
          (consult--read
           (consult--dynamic-collection
               (lambda (input)
                 (mapcar (lambda (row)
                           (let ((word (nth 0 row))
                                 (gender (nth 2 row))
                                 (number (nth 3 row))
                                 (ipa (my-french-lexique-to-ipa (nth 5 row)))
                                 (infover (nth 6 row)))
                             ;; Format the string for the completion buffer
                             (cons
