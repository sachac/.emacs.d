							 (with-current-buffer (find-file-noselect my-org-bookmark-file)
								 (org-map-entries
									(lambda ()
										(let ((title (org-entry-get (point) "ITEM"))
													(url (or (org-entry-get (point) "URL")
																	 (progn
																		 (let ((end (save-excursion (org-end-of-subtree))))
