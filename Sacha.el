                      (format "<div class=\"transcript-heading\"><span class=\"audio-time\" data-start=\"%f\">%s</span> <strong>%s</strong></div>"
                              (floor (/ (elt cue 1) 1000))
                              (format-seconds "%02h:%02m:%02s" (floor (/ (elt cue 1) 1000)))
